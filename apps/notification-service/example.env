PORT=3013

# This service owns its database exclusively. No other service connects to it.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=root
DATABASE_NAME=notification_db

RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_PREFETCH=10
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_MAX_ATTEMPTS=10

MAX_PROCESSING_ATTEMPTS=5
WEBHOOK_SIGNING_SECRET=local-dev-secret
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_BATCH_SIZE=20

# Public base URL of the API, used to build result links in notifications
PUBLIC_API_URL=http://localhost:3001
