{
  "name": "notification-service",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "node dist/main",
    "dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "build:tsc-only": "tsc --noEmit",
    "typeorm": "NODE_ENV=migration NODE_OPTIONS='-r tsconfig-paths/register' typeorm-ts-node-commonjs",
    "migration:generate": "yarn typeorm migration:generate -d ./src/data-source.ts",
    "migration:create": "yarn typeorm migration:create",
    "migration:run": "yarn typeorm migration:run -d ./src/data-source.ts",
    "migration:revert": "yarn typeorm migration:revert -d ./src/data-source.ts"
  },
  "dependencies": {
    "@app/contracts": "*",
    "@app/logger": "*",
    "@app/messaging": "*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "eslint-config-custom": "*",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig": "*",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1"
    }
  },
  "lint-staged": {
    "*.(js|ts|tsx)": "eslint --fix",
    "*.(md|json)": "prettier --write"
  }
}
