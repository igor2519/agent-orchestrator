APP_NAME=Boilerplate
PORT=3001

# API key is used to authenticate API calls from Next.js backend.
API_KEY=oe8NEC1Fv9CmJ2X0SJAXm8y4NAKQndt6

FRONTEND_HOST_URL=http://localhost:3000
BACKEND_HOST_URL=http://localhost:3001
# Add comma-separated domains which should be able to access this server
# By default frontend and backend are hosted on a same domain so no CORS are need to be configured
ALLOWED_CORS_ORIGINS=http://localhost:3000

ENABLE_SWAGGER=true

# Database connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=root
DATABASE_NAME=boilerplate

# JWT-token config
# This is a random auth secret. It must have the same value as NEXTAUTH_SECRET in a frontend app.
JWT_SECRET=x+lkdvIfdDnLqscDoUVA1daySduymECX5oY16s7RekHxE+fw8IKku9ntuqY+Cpr+P08PeyZgGhmeGV5cVe1gww==
OTP_JWT_SECRET=OtpSecret
OTP_TOKEN_EXPIRATION=2h

# AWS config
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The base URL of the location where the uploaded files are available
# You can keep keep default value in case you are not using any CDN or serving files publicly in the bucket
AWS_CDN_DOMAIN=https://$AWS_BUCKET_NAME.s3.$AWS_REGION.amazonaws.com

# Mailhog settings
# Leave it empty to use production email service
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# Brevo email service settings
BREVO_HOST=https://api.brevo.com/v3
BREVO_API_KEY=

# --- Messaging ---
# Broker credentials. Only docker-compose.prod.yml consumes these - the local
# dev broker keeps RabbitMQ's built-in guest/guest, which it refuses to accept
# over anything but loopback. In production RABBITMQ_URL must carry the same
# credentials, e.g. amqp://orchestrator:<password>@127.0.0.1:5672
RABBITMQ_USER=orchestrator
RABBITMQ_PASSWORD=change-me-in-production

RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_PREFETCH=10
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_MAX_ATTEMPTS=10
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Local only: permits callbacks to loopback/private addresses (mock receiver)
ALLOW_PRIVATE_CALLBACK_URLS=false

# Must match the notification service's value
WEBHOOK_SIGNING_SECRET=local-dev-secret
