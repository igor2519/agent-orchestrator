{
  "name": "api",
  "version": "0.0.1",
  "description": "API gateway: HTTP ingress, validation, idempotency, persistence and event publishing",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "typeorm": "NODE_ENV=migration NODE_OPTIONS='-r tsconfig-paths/register' typeorm-ts-node-commonjs",
    "migration:generate": "yarn typeorm migration:generate -d ./src/data-source.ts",
    "migration:create": "yarn typeorm migration:create",
    "migration:run": "yarn typeorm migration:run -d ./src/data-source.ts",
    "migration:revert": "yarn typeorm migration:revert -d ./src/data-source.ts",
    "migration:show": "yarn typeorm migration:show -d ./src/data-source.ts",
    "gen:api-client": "NODE_ENV=api-client node dist/generate-api-client.js"
  },
  "dependencies": {
    "@app/contracts": "*",
    "@app/logger": "*",
    "@app/messaging": "*",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "cls-hooked": "^4.2.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "joi": "^18.2.8",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.1",
    "passport": "^0.7.0",
    "passport-cookie": "^1.0.9",
    "passport-headerapikey": "^1.2.2",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "typeorm": "^1.1.1",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cls-hooked": "^4.3.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^13.0.3",
    "eslint-config-custom": "*",
    "jest": "^30.5.1",
    "jest-mock": "^30.5.1",
    "passport-local": "^1.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig": "*",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1",
      "test/(.*)": "<rootDir>/test/$1"
    }
  },
  "lint-staged": {
    "*.(js|ts|tsx)": "eslint --fix",
    "*.(md|json)": "prettier --write"
  }
}
