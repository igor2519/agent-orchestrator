{
  "name": "@app/messaging",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "build:tsc-only": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@app/contracts": "*",
    "@app/logger": "*",
    "amqplib": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@types/jest": "^30.0.0",
    "eslint-config-custom": "*",
    "jest": "^30.5.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "tsconfig": "*",
    "typeorm": "^1.1.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.(js|ts)": "eslint --fix",
    "*.(md|json)": "prettier --write"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
