{
  "name": "agent-orchestrator",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "setup": "yarn setup:husky && yarn setup:env && yarn docker:local",
    "setup:env": "cp ./apps/backend/example.env ./apps/backend/.env && cp ./apps/frontend/example.env ./apps/frontend/.env",
    "setup:husky": "yarn setup:husky:nvm && husky",
    "setup:husky:nvm": "mkdir -p ~/.config/husky && cp ./.husky/.huskyrc ~/.config/husky/init.sh",
    "deploy": "turbo run deploy",
    "build:tsc-only": "turbo run build:tsc-only",
    "docker:local": "turbo run docker:local",
    "migration:run": "turbo run migration:run",
    "gen:api-client": "turbo run gen:api-client",
    "pre-commit": "yarn gen:api-client && lint-staged",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tsconfig": "*",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "yarn": ">=1.22.0 <2.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.(md|json)": "prettier --write"
  }
}
